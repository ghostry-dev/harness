/**
 * Managed by the @ghostry meta repo (.templates/all/.oxfmtrc.jsonc). Edit it
 * there and run `bun .scripts/sync.ts`; changes made here are overwritten.
 */
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "experimentalOperatorPosition": "start",
  "quoteProps": "as-needed",
  "objectWrap": "collapse",
  "singleQuote": false,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": ["**/bun.lock"],
  "jsdoc": { "capitalizeDescriptions": false, "commentLineStrategy": "keep" },
}
